{
  "name": "Pleros Mobile",
  "short_name": "Pleros",
  "description": "Pleros field apps — warehouse, delivery, and sales",
  "start_url": "/m/warehouse",
  "scope": "/m/",
  "display": "standalone",
  "background_color": "#09090B",
  "theme_color": "#09090B",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/favicon-32.png",
      "sizes": "32x32",
      "type": "image/png"
    },
    {
      "src": "/pleros-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "/pleros-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Warehouse",
      "short_name": "Warehouse",
      "url": "/m/warehouse",
      "icons": [{ "src": "/pleros-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Delivery",
      "short_name": "Delivery",
      "url": "/m/delivery",
      "icons": [{ "src": "/pleros-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Sales",
      "short_name": "Sales",
      "url": "/m/sales",
      "icons": [{ "src": "/pleros-icon-192.png", "sizes": "192x192" }]
    }
  ]
}
