# Vite + Express unified app on :4000
# These are build-time for production Docker/Render (see apps/web/Dockerfile + render.yaml).
VITE_GATEWAY_URL=/api/v1
# Card checkout / invoice pay (Stripe Elements) — required or UI shows Missing VITE_STRIPE_PUBLISHABLE_KEY
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Optional — external admin origin; omit to use same-host /admin links
# VITE_WEB_ADMIN_ORIGIN=http://localhost:4000
