generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-analytics"
}

datasource db {
  provider = "sqlite"
  url      = env("ANALYTICS_DATABASE_URL")
}

model DailyKpiSnapshot {
  id          String   @id @default(cuid())
  tenantId    String
  date        DateTime
  ordersCount Int
  revenue     Decimal 
  skusActive  Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, date])
  @@index([tenantId])
}

model CelestialConversation {
  id        String             @id @default(cuid())
  tenantId  String
  userId    String
  role      String
  surface   String             @default("shop")
  title     String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  CelestialMessage[]

  @@index([tenantId, userId])
}

model CelestialMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime @default(now())
  conversation   CelestialConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}
