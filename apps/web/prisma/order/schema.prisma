generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-order"
}

datasource db {
  provider = "sqlite"
  url      = env("ORDER_DATABASE_URL")
}

model Order {
  id              String          @id @default(cuid())
  tenantId        String
  /// Human-facing number, sequential per tenant and shown as ORD-<n>. Null only for orders created before
  /// numbering existed, until the backfill (scripts/backfill-order-numbers.ts) assigns one.
  orderNumber     Int?
  customerId      String
  channel         OrderChannel
  status          OrderStatus     @default(PENDING)
  totalAmount     Decimal        
  amountPaid      Decimal         @default(0)
  taxAmount       Decimal         @default(0)
  paymentMethod   PaymentMethod
  paymentIntentId String?
  salesRepId      String?
  priority        OrderPriority   @default(NORMAL)
  failureReason   String?
  notes           String?
  shippingAddress Json?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lineItems       OrderLineItem[]
  saga            OrderSaga?
  invoice         Invoice?
  shipments       OrderShipment[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
}

/// One row per tenant: the last order number handed out. Incremented atomically when an order is created.
model OrderCounter {
  tenantId   String @id
  lastNumber Int
}

model OrderLineItem {
  id                  String   @id @default(cuid())
  orderId             String
  skuId               String
  warehouseId         String
  quantity            Int
  quantityAllocated   Int      @default(0)
  quantityBackordered Int      @default(0)
  returnedQty         Int      @default(0)
  /// Units already billed on an invoice (PLR-155); lets follow-up shipments price per line.
  quantityInvoiced    Int      @default(0)
  fulfillmentType     String   @default("STOCK")
  supplierId          String?
  dropShipPoId        String?
  preferredBatchId    String?
  promiseDate         DateTime?
  unitPrice           Decimal 
  taxAmount           Decimal  @default(0)
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  backorder           BackorderLine?

  @@index([orderId])
  @@index([skuId])
  @@index([fulfillmentType])
}

model BackorderLine {
  id              String           @id @default(cuid())
  tenantId        String
  orderId         String
  orderLineItemId String           @unique
  skuId           String
  warehouseId     String
  quantity        Int
  quantityFilled  Int              @default(0)
  status          BackorderStatus  @default(OPEN)
  promiseDate     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderLineItem   OrderLineItem    @relation(fields: [orderLineItemId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, skuId, warehouseId])
  @@index([orderId])
}

/// Records that a fulfillment task's short picks were moved to backorder for a line, so a retried
/// dispatch does not move them twice. Written in the same transaction as the quantity changes.
model BackorderMove {
  id                String   @id @default(cuid())
  tenantId          String
  fulfillmentTaskId String
  orderLineItemId   String
  createdAt         DateTime @default(now())

  @@unique([tenantId, fulfillmentTaskId, orderLineItemId])
}

/// Records that a fulfillment task has been invoiced, in the same transaction as the invoice
/// change, so a retried dispatch does not bill the same shipment twice.
model ShipmentInvoice {
  id                String   @id @default(cuid())
  tenantId          String
  fulfillmentTaskId String
  orderId           String
  invoiceId         String
  createdAt         DateTime @default(now())

  @@unique([tenantId, fulfillmentTaskId])
  @@index([orderId])
}

enum BackorderStatus {
  OPEN
  PARTIAL
  FILLED
  CANCELLED
}

model OrderSaga {
  id              String     @id @default(cuid())
  orderId         String     @unique
  tenantId        String
  status          SagaStatus
  correlationId   String
  completedSteps Json 
  compensations   Json       
  failureReason   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

enum OrderStatus {
  PENDING
  AWAITING_APPROVAL
  CONFIRMED
  BACKORDERED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
  RETURNED
}

enum OrderChannel {
  POS
  B2B_PORTAL
  SALES_REP
  API
  EDI
  SHOPIFY
  EBAY
  WALMART
  AMAZON
}

enum PaymentMethod {
  CARD
  ACH
  CHECK
  CASH
  NET_TERMS
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SagaStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPENSATING
  FAILED
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  CREDITED
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  orderId        String        @unique
  invoiceNumber  String
  customerId     String
  status         InvoiceStatus @default(ISSUED)
  subtotal       Decimal
  taxAmount      Decimal
  totalAmount    Decimal
  amountPaid     Decimal       @default(0)
  amountCredited Decimal       @default(0)
  currency       String        @default("USD")
  fxRateToBase   Decimal       @default(1.0)
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  journalEntryId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creditMemos    CreditMemo[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, issuedAt])
}

model CreditMemo {
  id             String   @id @default(cuid())
  tenantId       String
  orderId        String
  invoiceId      String
  memoNumber     String
  customerId     String
  totalAmount    Decimal
  reason         String?
  lines          Json
  journalEntryId String?
  createdAt      DateTime @default(now())
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memoNumber])
  @@index([tenantId, orderId])
  @@index([tenantId, invoiceId])
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  DELIVERED
}

model OrderShipment {
  id             String         @id @default(cuid())
  tenantId       String
  orderId        String
  shipmentNo     Int            @default(1)
  status         ShipmentStatus @default(PENDING)
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  lineItems      Json
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@index([tenantId, status])
}

enum PostingJobKind {
  INVOICE_JOURNAL
  INVOICE_EXTENSION_JOURNAL
  COGS_JOURNAL
  COGS_REVERSAL_JOURNAL
  CREDIT_MEMO_JOURNAL
  AR_PAYMENT_JOURNAL
  AP_PAYMENT_JOURNAL
  PO_RECEIPT_JOURNAL
  EXPENSE_APPROVAL_JOURNAL
  EXPENSE_PAID_JOURNAL
  GIFT_CARD_ISSUE_JOURNAL
  GIFT_CARD_REDEEM_JOURNAL
  STOCK_WRITE_OFF_JOURNAL
  STOCK_FOUND_JOURNAL
  INVOICE_SYNC
  CREDIT_RELEASE
  BACKORDER_FILL
  DELIVERY_ADVANCE
  ORDER_CANCEL
}

enum PostingJobStatus {
  PENDING
  RUNNING
  DONE
  DEAD
}

/// Transactional outbox for general-ledger postings. Written in the same transaction as the
/// business change; a worker posts to the ledger database asynchronously with retries.
model PostingJob {
  id             String           @id @default(cuid())
  tenantId       String
  kind           PostingJobKind
  sourceType     String
  sourceId       String
  variant        String           @default("")
  dedupeKey      String           @unique
  payload        Json
  status         PostingJobStatus @default(PENDING)
  attempts       Int              @default(0)
  nextAttemptAt  DateTime         @default(now())
  leaseUntil     DateTime?
  lastError      String?
  journalEntryId String?
  createdAt      DateTime         @default(now())
  doneAt         DateTime?

  @@index([status, nextAttemptAt])
  @@index([tenantId, status])
  @@index([tenantId, sourceType, sourceId])
}
