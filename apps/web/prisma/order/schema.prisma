generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-order"
}

datasource db {
  provider = "postgresql"
  url      = env("ORDER_DATABASE_URL")
}

model Order {
  id              String          @id @default(cuid())
  tenantId        String
  customerId      String
  channel         OrderChannel
  status          OrderStatus     @default(PENDING)
  totalAmount     Decimal        
  amountPaid      Decimal         @default(0)
  taxAmount       Decimal         @default(0)
  paymentMethod   PaymentMethod
  paymentIntentId String?
  salesRepId      String?
  priority        OrderPriority   @default(NORMAL)
  failureReason   String?
  notes           String?
  shippingAddress Json?
  confirmedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lineItems       OrderLineItem[]
  saga            OrderSaga?
  invoice         Invoice?
  shipments       OrderShipment[]

  @@index([tenantId, status])
  @@index([tenantId, customerId])
  @@index([tenantId, createdAt])
}

model OrderLineItem {
  id                  String   @id @default(cuid())
  orderId             String
  skuId               String
  warehouseId         String
  quantity            Int
  quantityAllocated   Int      @default(0)
  quantityBackordered Int      @default(0)
  returnedQty         Int      @default(0)
  fulfillmentType     String   @default("STOCK")
  supplierId          String?
  dropShipPoId        String?
  preferredBatchId    String?
  promiseDate         DateTime?
  unitPrice           Decimal 
  taxAmount           Decimal  @default(0)
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  backorder           BackorderLine?

  @@index([orderId])
  @@index([skuId])
  @@index([fulfillmentType])
}

model BackorderLine {
  id              String           @id @default(cuid())
  tenantId        String
  orderId         String
  orderLineItemId String           @unique
  skuId           String
  warehouseId     String
  quantity        Int
  quantityFilled  Int              @default(0)
  status          BackorderStatus  @default(OPEN)
  promiseDate     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderLineItem   OrderLineItem    @relation(fields: [orderLineItemId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, skuId, warehouseId])
  @@index([orderId])
}

enum BackorderStatus {
  OPEN
  PARTIAL
  FILLED
  CANCELLED
}

model OrderSaga {
  id              String     @id @default(cuid())
  orderId         String     @unique
  tenantId        String
  status          SagaStatus
  correlationId   String
  completedSteps Json 
  compensations   Json       
  failureReason   String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  order           Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  BACKORDERED
  PROCESSING
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  FAILED
  RETURNED
}

enum OrderChannel {
  POS
  B2B_PORTAL
  SALES_REP
  API
  EDI
}

enum PaymentMethod {
  CARD
  ACH
  CHECK
  CASH
  NET_TERMS
}

enum OrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SagaStatus {
  PENDING
  RUNNING
  COMPLETED
  COMPENSATING
  FAILED
}

enum InvoiceStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  CREDITED
}

model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  orderId        String        @unique
  invoiceNumber  String
  customerId     String
  status         InvoiceStatus @default(ISSUED)
  subtotal       Decimal
  taxAmount      Decimal
  totalAmount    Decimal
  amountPaid     Decimal       @default(0)
  amountCredited Decimal       @default(0)
  issuedAt       DateTime      @default(now())
  dueAt          DateTime?
  journalEntryId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  creditMemos    CreditMemo[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, customerId])
  @@index([tenantId, status])
  @@index([tenantId, issuedAt])
}

model CreditMemo {
  id             String   @id @default(cuid())
  tenantId       String
  orderId        String
  invoiceId      String
  memoNumber     String
  customerId     String
  totalAmount    Decimal
  reason         String?
  lines          Json
  journalEntryId String?
  createdAt      DateTime @default(now())
  invoice        Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([tenantId, memoNumber])
  @@index([tenantId, orderId])
  @@index([tenantId, invoiceId])
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  DELIVERED
}

model OrderShipment {
  id             String         @id @default(cuid())
  tenantId       String
  orderId        String
  shipmentNo     Int            @default(1)
  status         ShipmentStatus @default(PENDING)
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?
  lineItems      Json
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId, orderId])
  @@index([tenantId, status])
}
