generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-tenant"
}

datasource db {
  provider = "sqlite"
  url      = env("TENANT_DATABASE_URL")
}

model TenantOrganization {
  id               String               @id
  slug             String               @unique
  displayName      String
  plan             TenantPlan           @default(STARTER)
  onboardingPhase  OnboardingPhase      @default(PROFILE)
  settings         Json                 
  billingEmail           String?
  stripeCustomerId       String?              @unique
  stripeSubscriptionId   String?
  billingStatus          String?
  timeZone         String               @default("Etc/UTC")
  industry         IndustryVertical     @default(GENERAL_WHOLESALE)
  suspended        Boolean              @default(false)
  metadata         Json                 
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  onboardingSteps  TenantOnboardingStep[]
  invites            TenantInvite[]

  @@index([slug])
}

model TenantInvite {
  id         String   @id @default(cuid())
  tenantId   String
  email      String
  role       String   @default("STAFF")
  token      String?  @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  acceptedAt DateTime?
  createdAt  DateTime @default(now())
  tenant     TenantOrganization @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, email])
}

model TenantOnboardingStep {
  id           String               @id @default(cuid())
  tenantId     String
  stepKey      String
  completed    Boolean              @default(false)
  completedAt  DateTime?
  payload      Json?
  tenant       TenantOrganization   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, stepKey])
  @@index([tenantId])
}

model WebhookSubscription {
  id          String   @id @default(cuid())
  tenantId    String
  event       String
  url         String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([tenantId])
}

enum TenantPlan {
  STARTER
  GROWTH
  ENTERPRISE
}

enum OnboardingPhase {
  PROFILE
  BILLING
  READY
}

enum IndustryVertical {
  TOBACCO_VAPE
  PHARMA
  FOOD_BEVERAGE
  ALCOHOL
  GENERAL_WHOLESALE
}

model AuditEvent {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType])
  @@index([tenantId, entityId])
}

model PosRegister {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  warehouseId String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model EdiTradingPartner {
  id               String        @id @default(cuid())
  tenantId         String
  code             String
  name             String
  isaId            String?
  inboundEnabled   Boolean       @default(true)
  outboundEnabled  Boolean       @default(true)
  autoCreateOrders Boolean       @default(true)
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  documents        EdiDocument[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

enum EdiDocType {
  PO_850
  INVOICE_810
  ASN_856
}

enum EdiDirection {
  INBOUND
  OUTBOUND
}

enum EdiDocStatus {
  RECEIVED
  PROCESSED
  SENT
  FAILED
}

model EdiDocument {
  id            String            @id @default(cuid())
  tenantId      String
  partnerId     String?
  docType       EdiDocType
  direction     EdiDirection
  status        EdiDocStatus      @default(RECEIVED)
  controlNumber String?
  payload       Json
  referenceType String?
  referenceId   String?
  errorMessage  String?
  createdAt     DateTime          @default(now())
  processedAt   DateTime?
  partner       EdiTradingPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([tenantId, docType, status])
  @@index([tenantId, createdAt])
  @@index([referenceType, referenceId])
}
