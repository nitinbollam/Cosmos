generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-ledger"
}

datasource db {
  provider = "sqlite"
  url      = env("LEDGER_DATABASE_URL")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model ChartAccount {
  id           String        @id @default(cuid())
  tenantId     String
  code         String
  name         String
  type         AccountType
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  journalLines JournalLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model JournalEntry {
  id                 String        @id @default(cuid())
  tenantId           String
  description        String
  postedAt           DateTime      @default(now())
  fiscalPeriodClosed Boolean       @default(false)
  isPosted           Boolean       @default(false)
  lines              JournalLine[]

  @@index([tenantId, postedAt])
}

model JournalLine {
  id        String       @id @default(cuid())
  entryId   String
  accountId String
  memo      String?
  debit     Decimal      @default(0)
  credit    Decimal      @default(0)
  entry     JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  account   ChartAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([entryId])
  @@index([accountId])
}

model BankAccount {
  id             String              @id @default(cuid())
  tenantId       String
  name           String
  accountNumber  String?
  chartAccountId String?
  currentBalance Decimal             @default(0)
  isActive       Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  statementLines BankStatementLine[]

  @@index([tenantId])
}

model BankStatementLine {
  id             String      @id @default(cuid())
  tenantId       String
  bankAccountId  String
  postedAt       DateTime
  description    String
  amount         Decimal
  reference      String?
  reconciled     Boolean     @default(false)
  reconciledAt   DateTime?
  journalEntryId String?
  bankAccount    BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId, bankAccountId])
  @@index([tenantId, reconciled])
  @@index([tenantId, postedAt])
}

enum AssetStatus {
  ACTIVE
  DISPOSED
  FULLY_DEPRECIATED
}

enum DepreciationMethod {
  STRAIGHT_LINE
  DECLINING_BALANCE
}

model FixedAsset {
  id                         String             @id @default(cuid())
  tenantId                   String
  assetCode                  String
  name                       String
  category                   String             @default("EQUIPMENT")
  acquisitionDate            DateTime
  cost                       Decimal
  salvageValue               Decimal            @default(0)
  usefulLifeMonths           Int                @default(60)
  depreciationMethod         DepreciationMethod @default(STRAIGHT_LINE)
  accumulatedDepreciation    Decimal            @default(0)
  netBookValue               Decimal
  status                     AssetStatus        @default(ACTIVE)
  assetAccountId             String?
  expenseAccountId           String?
  accumDepreciationAccountId String?
  disposedAt                 DateTime?
  disposalProceeds           Decimal?
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  @@unique([tenantId, assetCode])
  @@index([tenantId, status])
}
