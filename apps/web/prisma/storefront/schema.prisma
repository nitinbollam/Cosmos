generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-storefront"
}

datasource db {
  provider = "sqlite"
  url      = env("STOREFRONT_DATABASE_URL")
}

enum QuoteStatus {
  OPEN
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUBMITTED
  EXPIRED
}

model B2BQuote {
  id                 String      @id @default(cuid())
  tenantId           String
  customerRef        String
  status             QuoteStatus @default(OPEN)
  notes              String?
  convertedOrderId   String?
  rejectionReason    String?
  approvedAt         DateTime?
  approvedByUserId   String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  lines              QuoteLine[]

  @@index([tenantId, status])
  @@index([convertedOrderId])
}

model QuoteLine {
  id          String   @id @default(cuid())
  quoteId     String
  lineNo      Int
  skuCode     String?
  description String
  qty         Int
  unitPrice   Decimal 
  quote       B2BQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@unique([quoteId, lineNo])
  @@index([quoteId])
}

model OrderTemplate {
  id          String              @id @default(cuid())
  tenantId    String
  customerRef String
  name        String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  lines       OrderTemplateLine[]

  @@index([tenantId, customerRef])
}

model OrderTemplateLine {
  id         String        @id @default(cuid())
  templateId String
  skuId      String
  quantity   Int
  template   OrderTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model QuoteCounterOffer {
  id        String                  @id @default(cuid())
  quoteId   String
  offeredBy String
  userId    String?
  notes     String?
  status    String                  @default("OPEN")
  createdAt DateTime                @default(now())
  lines     QuoteCounterOfferLine[]

  @@index([quoteId])
}

model QuoteCounterOfferLine {
  id             String            @id @default(cuid())
  counterOfferId String
  lineNo         Int
  qty            Int
  unitPrice      Decimal
  counterOffer   QuoteCounterOffer @relation(fields: [counterOfferId], references: [id], onDelete: Cascade)

  @@index([counterOfferId])
}
