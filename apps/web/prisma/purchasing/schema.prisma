generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-purchasing"
}

datasource db {
  provider = "sqlite"
  url      = env("PURCHASING_DATABASE_URL")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  SUBMITTED
  PARTIALLY_RECEIVED
  CLOSED
  CANCELLED
}

enum VendorBillStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum BillMatchStatus {
  PENDING
  MATCHED
  EXCEPTION
}

model Supplier {
  id             String          @id @default(cuid())
  tenantId       String
  code           String
  name           String
  email          String?
  phone          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
  vendorBills    VendorBill[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model PurchaseOrder {
  id         String                @id @default(cuid())
  tenantId   String
  supplierId String
  number     String
  status     PurchaseOrderStatus   @default(DRAFT)
  notes             String?
  freightAmount     Decimal               @default(0)
  dutyAmount        Decimal               @default(0)
  otherLandedAmount Decimal               @default(0)
  landedCostNotes   String?
  amountPaid        Decimal               @default(0)
  currency          String                @default("USD")
  fxRateToBase      Decimal               @default(1.0)
  createdAt         DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  supplier   Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines      PurchaseOrderLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([supplierId])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  lineNo          Int
  skuCode         String?
  description     String
  qtyOrdered      Int
  qtyReceived     Int           @default(0)
  unitCost        Decimal?     
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, lineNo])
  @@index([purchaseOrderId])
}

model VendorBill {
  id              String           @id @default(cuid())
  tenantId        String
  supplierId      String
  purchaseOrderId String?
  billNumber      String
  status          VendorBillStatus @default(ISSUED)
  subtotal        Decimal
  taxAmount       Decimal          @default(0)
  totalAmount     Decimal
  amountPaid      Decimal          @default(0)
  currency        String           @default("USD")
  fxRateToBase    Decimal          @default(1.0)
  issuedAt        DateTime         @default(now())
  dueAt           DateTime?
  journalEntryId  String?
  notes           String?
  matchStatus     BillMatchStatus  @default(PENDING)
  matchNotes      String?
  poTotal         Decimal?
  receivedTotal   Decimal?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines           VendorBillLine[]

  @@unique([tenantId, billNumber])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@index([tenantId, purchaseOrderId])
}

model VendorBillLine {
  id          String     @id @default(cuid())
  billId      String
  lineNo      Int
  skuCode     String?
  description String
  quantity    Int
  unitCost    Decimal
  bill        VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, lineNo])
  @@index([billId])
}

