generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-purchasing"
}

datasource db {
  provider = "sqlite"
  url      = env("PURCHASING_DATABASE_URL")
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  SUBMITTED
  PARTIALLY_RECEIVED
  CLOSED
  CANCELLED
}

enum PurchaseRequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CONVERTED
  CANCELLED
}

enum VendorBillStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum BillMatchStatus {
  PENDING
  MATCHED
  EXCEPTION
}

model Supplier {
  id             String          @id @default(cuid())
  tenantId       String
  code           String
  name           String
  email          String?
  phone          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  purchaseOrders PurchaseOrder[]
  vendorBills    VendorBill[]
  requisitions   PurchaseRequisition[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model PurchaseOrder {
  id         String                @id @default(cuid())
  tenantId   String
  supplierId String
  number     String
  status     PurchaseOrderStatus   @default(DRAFT)
  notes             String?
  freightAmount     Decimal               @default(0)
  dutyAmount        Decimal               @default(0)
  otherLandedAmount Decimal               @default(0)
  landedCostNotes   String?
  amountPaid        Decimal               @default(0)
  currency          String                @default("USD")
  fxRateToBase      Decimal               @default(1.0)
  /// User who created the PO; null for POs created before this was recorded.
  createdBy         String?
  /// The requisition this PO was converted from; null for every PO not created by conversion.
  /// Deliberately a plain column: a foreign key or unique index here makes `db push` rebuild or refuse on an
  /// existing table. One PO per requisition is enforced by the conversion's conditional update (see
  /// PurchaseRequisition.purchaseOrderId).
  requisitionId     String?
  createdAt         DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  supplier   Supplier              @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines      PurchaseOrderLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([supplierId])
  @@index([tenantId, requisitionId])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  lineNo          Int
  skuCode         String?
  description     String
  qtyOrdered      Int
  qtyReceived     Int           @default(0)
  unitCost        Decimal?     
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, lineNo])
  @@index([purchaseOrderId])
}

/// A request to buy, signed off by a manager before any PO is created from it.
model PurchaseRequisition {
  id                String                    @id @default(cuid())
  tenantId          String
  number            String
  status            PurchaseRequisitionStatus @default(DRAFT)
  requestedBy       String
  supplierId        String?
  currency          String                    @default("USD")
  freightAmount     Decimal                   @default(0)
  dutyAmount        Decimal                   @default(0)
  otherLandedAmount Decimal                   @default(0)
  notes             String?
  /// Bumped on every submit. An approval is valid only for the revision it was requested for.
  revision          Int                       @default(0)
  /// sha256 of the purchasing details submitted in this revision (supplier, currency, landed amounts, lines).
  /// Computed over a canonical form: lines sorted by lineNo, Decimals as fixed strings, never JS floats.
  detailsHash       String?
  /// The ApprovalRequest (tenant database) for the current revision: the approval link. Generated at submit and
  /// stored here before the request exists, so a retried submit reuses it. The request decides; this link says which
  /// request counts. Withdrawal clears it (invalidating any approval); cancellation and conversion freeze it.
  approvalRequestId String?                   @unique
  submittedAt       DateTime?
  approvedBy        String?
  approvedAt        DateTime?
  rejectedBy        String?
  rejectedAt        DateTime?
  rejectReason      String?
  cancelledBy       String?
  cancelledAt       DateTime?
  cancelReason      String?
  /// The PO converted from this requisition. Unique, but that alone does not stop a second PO being created:
  /// conversion must move APPROVED -> CONVERTED conditionally and create the PO in the same transaction.
  purchaseOrderId   String?                   @unique
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  supplier          Supplier?                 @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines             PurchaseRequisitionLine[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([tenantId, requestedBy])
  @@index([supplierId])
}

/// One row per tenant: the last requisition number handed out. Incremented in the transaction that creates the
/// requisition, so two requisitions created at once cannot receive the same number.
model PurchaseRequisitionCounter {
  tenantId   String @id
  lastNumber Int
}

/// Audit outbox for requisition changes whose audit event lives in the tenant database (withdrawn, cancelled,
/// converted...). Written in the same purchasing transaction as the change, with the acting user, then copied to
/// AuditEvent under the same id; deliveredAt is set once that copy exists. A lost copy is redelivered, never doubled.
model PurchaseRequisitionEvent {
  id            String    @id
  tenantId      String
  requisitionId String
  action        String
  userId        String?
  metadata      Json?
  createdAt     DateTime  @default(now())
  deliveredAt   DateTime?

  @@index([tenantId, requisitionId])
  @@index([deliveredAt, createdAt])
}

model PurchaseRequisitionLine {
  id            String              @id @default(cuid())
  requisitionId String
  lineNo        Int
  skuCode       String?
  description   String
  qtyRequested  Int
  unitCost      Decimal?
  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@unique([requisitionId, lineNo])
  @@index([requisitionId])
}

model VendorBill {
  id              String           @id @default(cuid())
  tenantId        String
  supplierId      String
  purchaseOrderId String?
  billNumber      String
  status          VendorBillStatus @default(ISSUED)
  subtotal        Decimal
  taxAmount       Decimal          @default(0)
  totalAmount     Decimal
  amountPaid      Decimal          @default(0)
  currency        String           @default("USD")
  fxRateToBase    Decimal          @default(1.0)
  issuedAt        DateTime         @default(now())
  dueAt           DateTime?
  journalEntryId  String?
  /// Bumped on every re-bill; each revision queues one PO receipt posting that brings the ledger to the bill's total.
  receiptRevision Int              @default(0)
  notes           String?
  matchStatus     BillMatchStatus  @default(PENDING)
  matchNotes      String?
  poTotal         Decimal?
  receivedTotal   Decimal?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  supplier        Supplier         @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  lines           VendorBillLine[]

  @@unique([tenantId, billNumber])
  @@index([tenantId, status])
  @@index([tenantId, supplierId])
  @@index([updatedAt])
  @@index([tenantId, purchaseOrderId])
}

model VendorBillLine {
  id          String     @id @default(cuid())
  billId      String
  lineNo      Int
  skuCode     String?
  description String
  quantity    Int
  unitCost    Decimal
  bill        VendorBill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, lineNo])
  @@index([billId])
}

