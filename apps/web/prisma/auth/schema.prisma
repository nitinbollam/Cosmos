generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-auth"
}

datasource db {
  provider = "sqlite"
  url      = env("AUTH_DATABASE_URL")
}

model User {
  id                     String    @id @default(cuid())
  tenantId               String
  email                  String
  passwordHash           String
  firstName              String
  lastName               String
  role                   Role      @default(STAFF)
  permissions Json 
  isActive               Boolean   @default(true)
  lastLoginAt            DateTime?
  refreshTokenHash       String?
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  emailVerifiedAt              DateTime?
  emailVerificationTokenHash   String?
  emailVerificationExpiresAt   DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

/// One row per signed-in device. Refresh tokens carry the row id as `sid`.
/// `User.refreshTokenHash` is kept only so tokens issued before this table existed
/// can refresh once; drop it in a later release.
model AuthSession {
  id               String    @id
  userId           String
  tenantId         String
  /// sha256 of the current refresh token
  refreshTokenHash String
  /// Previous hash, still accepted briefly after a rotation so two tabs refreshing at once don't revoke each other
  prevTokenHash    String?
  rotatedAt        DateTime?
  userAgent        String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?

  @@index([userId])
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(STARTER)
  isActive  Boolean  @default(true)
  settings  Json     
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

enum Role {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  WAREHOUSE_STAFF
  SALES_REP
  DRIVER
  ACCOUNTANT
  VIEWER
  STAFF
}

enum Plan {
  STARTER
  GROWTH
  ENTERPRISE
}
