generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-inventory"
}

datasource db {
  provider = "sqlite"
  url      = env("INVENTORY_DATABASE_URL")
}

model StockLedgerEntry {
  id            String   @id @default(cuid())
  tenantId      String
  skuId         String
  warehouseId   String
  locationId    String?
  batchId       String?
  eventType     String
  quantityDelta Int
  quantityAfter Int
  unitCost      Decimal 
  referenceId   String?
  referenceType String?
  performedBy   String
  correlationId String
  occurredAt    DateTime @default(now())

  @@index([tenantId, skuId, warehouseId])
  @@index([tenantId, occurredAt])
  @@index([correlationId])
  @@index([batchId])
}

model StockLevel {
  id                String   @id @default(cuid())
  tenantId          String
  skuId             String
  warehouseId       String
  locationId        String?
  batchId           String?
  quantityOnHand    Int      @default(0)
  quantityReserved  Int      @default(0)
  quantityAvailable Int      @default(0)
  reorderPoint      Int      @default(0)
  reorderQty        Int      @default(0)
  leadTimeDays      Int      @default(7)
  expiryDate        DateTime?
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, skuId, warehouseId, batchId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, skuId])
}

model SKU {
  id                String   @id @default(cuid())
  tenantId          String
  code              String
  name              String
  description       String?
  category          String
  subcategory       String?
  barcode           String?
  unitOfMeasure     String   @default("EACH")
  weightGrams       Decimal?
  isTobacco         Boolean  @default(false)
  /** Explicit alcohol flag — clearer than inferring from ageRestricted alone. */
  isAlcohol         Boolean  @default(false)
  isRegulated       Boolean  @default(false)
  /** Age-gated product (alcohol, tobacco, etc.). Tobacco SKUs should also set this. */
  ageRestricted     Boolean  @default(false)
  /** Minimum buyer/recipient age when ageRestricted. Defaults to tenant policy when null. */
  minimumAge        Int?
  manufacturerId    String?
  manufacturerDid   String?
  exciseTaxCategory String?
  cost              Decimal 
  price             Decimal 
  minPrice          Decimal?
  isActive          Boolean  @default(true)
  isKit             Boolean  @default(false)
  trackLot          Boolean  @default(false)
  trackSerial       Boolean  @default(false)
  imageUrls Json 
  attributes        Json     
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  lots              InventoryLot[]
  serials           SerialUnit[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, category])
  @@index([barcode])
  @@index([manufacturerDid])
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   Json
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bins      BinLocation[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model BinLocation {
  id          String    @id @default(cuid())
  tenantId    String
  warehouseId String
  code        String
  aisle       String?
  zone        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, warehouseId, code])
  @@index([tenantId, warehouseId])
}

model StockReservation {
  id          String            @id @default(cuid())
  tenantId    String
  skuId       String
  warehouseId String
  batchId     String?
  orderId     String
  quantity    Int
  expiresAt   DateTime
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())

  @@index([tenantId, orderId])
  @@index([tenantId, skuId, warehouseId])
  @@index([expiresAt])
}

enum ReservationStatus {
  ACTIVE
  FULFILLED
  RELEASED
  EXPIRED
}

model InventoryLot {
  id          String    @id @default(cuid())
  tenantId    String
  skuId       String
  warehouseId String
  batchCode   String
  expiryDate  DateTime?
  supplierId  String?
  receivedAt  DateTime  @default(now())
  sku         SKU       @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([tenantId, skuId, warehouseId, batchCode])
  @@index([tenantId, skuId])
  @@index([tenantId, expiryDate])
}

enum SerialUnitStatus {
  IN_STOCK
  RESERVED
  SHIPPED
  RETURNED
}

model SerialUnit {
  id             String           @id @default(cuid())
  tenantId       String
  skuId          String
  serialNumber   String
  status         SerialUnitStatus @default(IN_STOCK)
  warehouseId    String?
  locationId     String?
  batchId        String?
  orderId        String?
  reservationId  String?
  receivedAt     DateTime         @default(now())
  sku            SKU              @relation(fields: [skuId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serialNumber])
  @@index([tenantId, skuId, status])
  @@index([tenantId, orderId])
}

model BillOfMaterials {
  id             String          @id @default(cuid())
  tenantId       String
  skuId          String
  bomNumber      String
  name           String
  description    String?
  version        String          @default("1.0")
  status         String          @default("ACTIVE") // ACTIVE, DRAFT, ARCHIVED
  laborCost      Decimal         @default(0)
  overheadCost   Decimal         @default(0)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  items          BomItem[]
  assemblyOrders AssemblyOrder[]

  @@unique([tenantId, bomNumber])
  @@index([tenantId, skuId])
  @@index([tenantId, status])
}

model BomItem {
  id                 String          @id @default(cuid())
  tenantId           String
  bomId              String
  componentSkuId     String
  quantity           Decimal
  scrapFactorPercent Decimal         @default(0)
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  bom                BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([tenantId, bomId])
  @@index([tenantId, componentSkuId])
}

model AssemblyOrder {
  id                String              @id @default(cuid())
  tenantId          String
  orderNumber       String
  bomId             String
  skuId             String
  warehouseId       String
  destinationBinId  String?
  quantityPlanned   Int
  quantityCompleted Int                 @default(0)
  status            String              @default("DRAFT") // DRAFT, RELEASED, IN_PROGRESS, COMPLETED, CANCELLED
  unitCost          Decimal?
  totalCost         Decimal?
  notes             String?
  startedAt         DateTime?
  completedAt       DateTime?
  createdBy         String
  completedBy       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  bom               BillOfMaterials     @relation(fields: [bomId], references: [id], onDelete: Restrict)
  items             AssemblyOrderItem[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, warehouseId])
  @@index([tenantId, status])
  @@index([tenantId, skuId])
}

model AssemblyOrderItem {
  id               String        @id @default(cuid())
  tenantId         String
  assemblyOrderId  String
  componentSkuId   String
  quantityRequired Decimal
  quantityConsumed Decimal       @default(0)
  unitCost         Decimal       @default(0)
  totalCost        Decimal       @default(0)
  batchId          String?
  locationId       String?
  assemblyOrder    AssemblyOrder @relation(fields: [assemblyOrderId], references: [id], onDelete: Cascade)

  @@index([tenantId, assemblyOrderId])
  @@index([tenantId, componentSkuId])
}
