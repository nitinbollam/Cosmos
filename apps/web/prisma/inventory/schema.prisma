generator client {
  provider = "prisma-client-js"
  output   = "../../generated/prisma-inventory"
}

datasource db {
  provider = "sqlite"
  url      = env("INVENTORY_DATABASE_URL")
}

model StockLedgerEntry {
  id            String   @id @default(cuid())
  tenantId      String
  skuId         String
  warehouseId   String
  locationId    String?
  batchId       String?
  eventType     String
  quantityDelta Int
  quantityAfter Int
  unitCost      Decimal 
  referenceId   String?
  referenceType String?
  performedBy   String
  correlationId String
  occurredAt    DateTime @default(now())

  @@index([tenantId, skuId, warehouseId])
  @@index([tenantId, occurredAt])
  @@index([correlationId])
  @@index([batchId])
}

model StockLevel {
  id                String   @id @default(cuid())
  tenantId          String
  skuId             String
  warehouseId       String
  locationId        String?
  batchId           String?
  quantityOnHand    Int      @default(0)
  quantityReserved  Int      @default(0)
  quantityAvailable Int      @default(0)
  reorderPoint      Int      @default(0)
  reorderQty        Int      @default(0)
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, skuId, warehouseId, batchId])
  @@index([tenantId, warehouseId])
  @@index([tenantId, skuId])
}

model SKU {
  id                String   @id @default(cuid())
  tenantId          String
  code              String
  name              String
  description       String?
  category          String
  subcategory       String?
  barcode           String?
  unitOfMeasure     String   @default("EACH")
  weightGrams       Decimal?
  isTobacco         Boolean  @default(false)
  isRegulated       Boolean  @default(false)
  manufacturerId    String?
  manufacturerDid   String?
  exciseTaxCategory String?
  cost              Decimal 
  price             Decimal 
  minPrice          Decimal?
  isActive          Boolean  @default(true)
  imageUrls Json 
  attributes        Json     
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, category])
  @@index([barcode])
  @@index([manufacturerDid])
}

model Warehouse {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  code      String
  address   Json
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bins      BinLocation[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model BinLocation {
  id          String    @id @default(cuid())
  tenantId    String
  warehouseId String
  code        String
  aisle       String?
  zone        String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([tenantId, warehouseId, code])
  @@index([tenantId, warehouseId])
}

model StockReservation {
  id          String            @id @default(cuid())
  tenantId    String
  skuId       String
  warehouseId String
  batchId     String?
  orderId     String
  quantity    Int
  expiresAt   DateTime
  status      ReservationStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())

  @@index([tenantId, orderId])
  @@index([tenantId, skuId, warehouseId])
  @@index([expiresAt])
}

enum ReservationStatus {
  ACTIVE
  FULFILLED
  RELEASED
  EXPIRED
}
