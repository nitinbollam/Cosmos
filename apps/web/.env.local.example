# Unified Pleros web — native API at /api/v1
NEXT_PUBLIC_GATEWAY_URL=/api/v1

# Embedded SQLite (generated by prepare-dev-env — one .db file per domain)
PLEROS_DATA_DIR=.data
AUTH_DATABASE_URL=file:./.data/pleros_auth.db
TENANT_DATABASE_URL=file:./.data/pleros_tenant.db
INVENTORY_DATABASE_URL=file:./.data/pleros_inventory.db
ORDER_DATABASE_URL=file:./.data/pleros_order.db
CRM_DATABASE_URL=file:./.data/pleros_crm.db
STOREFRONT_DATABASE_URL=file:./.data/pleros_storefront.db
PURCHASING_DATABASE_URL=file:./.data/pleros_purchasing.db
WMS_DATABASE_URL=file:./.data/pleros_wms.db
DISPATCH_DATABASE_URL=file:./.data/pleros_dispatch.db
PAYMENT_DATABASE_URL=file:./.data/pleros_payment.db
COMPLIANCE_DATABASE_URL=file:./.data/pleros_compliance.db
LEDGER_DATABASE_URL=file:./.data/pleros_ledger.db
NOTIFICATION_DATABASE_URL=file:./.data/pleros_notification.db
ANALYTICS_DATABASE_URL=file:./.data/pleros_analytics.db
MARKETPLACE_DATABASE_URL=file:./.data/pleros_marketplace.db
SALESCHANNELS_DATABASE_URL=file:./.data/pleros_sales_channels.db

JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production

# Stripe (card checkout + SaaS billing — optional until you test payments/billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
STRIPE_RETURN_URL=http://localhost:4000/checkout
APP_URL=http://localhost:4000

# Shopify sales channel (Phase 5A — optional until testing channel sync)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Required for encrypted channel credentials (generate: openssl rand -base64 32)
ENCRYPTION_KEY=

NEXT_PUBLIC_WEB_ADMIN_ORIGIN=http://localhost:4000
