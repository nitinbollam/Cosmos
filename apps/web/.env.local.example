# Unified Cosmos web — native API at /api/v1
NEXT_PUBLIC_GATEWAY_URL=/api/v1

# Embedded SQLite (generated by prepare-dev-env — one .db file per domain)
COSMOS_DATA_DIR=.data
AUTH_DATABASE_URL=file:./.data/cosmos_auth.db
TENANT_DATABASE_URL=file:./.data/cosmos_tenant.db
INVENTORY_DATABASE_URL=file:./.data/cosmos_inventory.db
ORDER_DATABASE_URL=file:./.data/cosmos_order.db
CRM_DATABASE_URL=file:./.data/cosmos_crm.db
STOREFRONT_DATABASE_URL=file:./.data/cosmos_storefront.db
PURCHASING_DATABASE_URL=file:./.data/cosmos_purchasing.db
WMS_DATABASE_URL=file:./.data/cosmos_wms.db
DISPATCH_DATABASE_URL=file:./.data/cosmos_dispatch.db
PAYMENT_DATABASE_URL=file:./.data/cosmos_payment.db
COMPLIANCE_DATABASE_URL=file:./.data/cosmos_compliance.db
LEDGER_DATABASE_URL=file:./.data/cosmos_ledger.db
NOTIFICATION_DATABASE_URL=file:./.data/cosmos_notification.db
ANALYTICS_DATABASE_URL=file:./.data/cosmos_analytics.db

JWT_SECRET=dev-jwt-secret-change-in-production
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-production

# Stripe (card checkout + SaaS billing — optional until you test payments/billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=
STRIPE_RETURN_URL=http://localhost:4000/checkout
APP_URL=http://localhost:4000

NEXT_PUBLIC_WEB_ADMIN_ORIGIN=http://localhost:4000
