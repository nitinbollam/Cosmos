{
  "name": "@cosmos/inventory-service",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node ../../scripts/prisma-generate-retry.mjs src/prisma/schema.prisma && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "lint": "node ../../scripts/eslint-soft.mjs",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "db:generate": "node ../../scripts/prisma-generate-retry.mjs src/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=src/prisma/schema.prisma",
    "db:dev": "prisma migrate dev --schema=src/prisma/schema.prisma",
    "dev": "pnpm run start:dev"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.10",
    "@nestjs/core": "^10.3.10",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/passport": "^10.0.3",
    "@prisma/client": "^5.18.0",
    "passport": "^0.7.0",
    "class-validator": "^0.14.1",
    "class-transformer": "^0.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "@cosmos/logger": "workspace:*",
    "@cosmos/event-bus": "workspace:*",
    "@cosmos/auth-middleware": "workspace:*",
    "@cosmos/types": "workspace:*",
    "@cosmos/config": "workspace:*",
    "@cosmos/metrics": "workspace:*",
    "@cosmos/tracing": "workspace:*"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.2",
    "@nestjs/testing": "^10.3.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "jest": "^29.7.0",
    "prisma": "^5.18.0",
    "ts-jest": "^29.2.2",
    "typescript": "^5.5.3"
  }
}
