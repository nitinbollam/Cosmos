generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FulfillmentTask {
  id             String                  @id @default(cuid())
  tenantId       String
  orderId        String
  status         FulfillmentTaskStatus   @default(PENDING)
  priority       String                  @default("NORMAL")
  correlationId  String
  warehouseId    String
  warehouseCode  String
  assignedUserId String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  pickLines      PickLine[]
  cartons        Carton[]

  @@unique([tenantId, orderId])
  @@index([tenantId, status])
  @@index([tenantId, updatedAt])
  @@index([tenantId, assignedUserId])
}

model PickLine {
  id          String          @id @default(cuid())
  taskId      String
  skuId       String
  warehouseId String
  quantity    Int
  pickedQty   Int             @default(0)
  status      PickLineStatus  @default(PENDING)
  task        FulfillmentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model ReceivingSession {
  id               String          @id @default(cuid())
  tenantId         String
  warehouseId      String
  poId             String?
  asnId            String?
  status           ReceivingStatus @default(OPEN)
  startedBy        String
  completedAt      DateTime?
  discrepancyNotes String?
  items            ReceivingItem[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenantId, warehouseId, status])
  @@index([tenantId, poId])
  @@index([tenantId])
}

model ReceivingItem {
  id                  String           @id @default(cuid())
  sessionId           String
  session             ReceivingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  skuId               String
  purchaseOrderLineId String?
  barcode             String?
  expectedQty         Int?
  receivedQty         Int              @default(0)
  damagedQty          Int              @default(0)
  batchId             String?
  expiryDate          DateTime?
  locationId          String?
  scannedBy           String
  scannedAt           DateTime         @default(now())

  @@index([sessionId])
  @@index([barcode])
  @@index([skuId])
  @@index([purchaseOrderLineId])
}

model Carton {
  id           String          @id @default(cuid())
  tenantId     String
  taskId       String
  task         FulfillmentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  cartonNumber Int
  weightGrams  Int?
  lengthCm     Int?
  widthCm      Int?
  heightCm     Int?
  trackingNum  String?
  carrier      String?
  labelUrl     String?
  sealedAt     DateTime?
  items        CartonItem[]
  createdAt    DateTime        @default(now())

  @@index([tenantId, taskId])
  @@index([taskId])
  @@index([tenantId])
}

model CartonItem {
  id       String @id @default(cuid())
  cartonId String
  carton   Carton @relation(fields: [cartonId], references: [id], onDelete: Cascade)
  skuId    String
  quantity Int

  @@index([cartonId])
  @@index([skuId])
}

enum FulfillmentTaskStatus {
  PENDING
  PICKING
  PACKED
  DISPATCHED
  CANCELLED
}

enum PickLineStatus {
  PENDING
  PICKED
  SHORT
}

enum ReceivingStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  DISCREPANCY
  CLOSED
}

model CycleCount {
  id           String           @id @default(cuid())
  tenantId     String
  warehouseId  String
  type         CycleCountType
  status       CycleCountStatus @default(DRAFT)
  scheduledFor DateTime?
  createdBy    String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  lines        CycleCountLine[]

  @@index([tenantId, warehouseId, status])
  @@index([tenantId, createdAt])
}

model CycleCountLine {
  id            String     @id @default(cuid())
  countId       String
  count         CycleCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  skuId         String
  locationLabel String?
  systemQty     Int
  countedQty    Int?

  @@index([countId])
  @@index([skuId])
}

enum CycleCountType {
  FULL
  ABC
  RANDOM
}

enum CycleCountStatus {
  DRAFT
  IN_PROGRESS
  PENDING_APPROVAL
  COMPLETED
  CANCELLED
}
