# ─── POSTGRES ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-this-strong-password

# ─── REDIS (optional; future job queues) ─────────────────────────────────────
REDIS_PASSWORD=change-this-redis-password

# ─── AUTH (@pleros/web) ──────────────────────────────────────────────────────
JWT_SECRET=replace-with-64-char-random-hex
JWT_REFRESH_SECRET=replace-with-64-char-different-random-hex
JWT_ACCESS_TTL=45m
JWT_REFRESH_TTL=7d
# Proxies in front of the app that append to X-Forwarded-For (1 = the host's load balancer only;
# 2 if Cloudflare or another proxy also sits in front). Used for per-IP login rate limits.
TRUSTED_PROXY_HOPS=1

# ─── SECRETS (@pleros/web) ───────────────────────────────────────────────────
# Encrypts stored integration credentials. Generate with: openssl rand -base64 32
# Changing it makes existing stored credentials unreadable.
ENCRYPTION_KEY=replace-with-openssl-rand-base64-32
# Signs outbound webhooks (X-Pleros-Signature). Required in production; webhooks are not sent without it.
WEBHOOK_SIGNING_SECRET=replace-with-64-char-random-hex

# ─── STRIPE ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_replace_me
STRIPE_RETURN_URL=https://your-domain/checkout

# ─── VITE (build-time — baked into @pleros/client SPA) ───────────────────────
# Required for Docker / Render image builds. Runtime-only env changes do NOT
# update the client bundle — rebuild the image after changing these.
# Staging: pk_test_… · Production: pk_live_…
VITE_GATEWAY_URL=/api/v1
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
# Optional — absolute admin origin when shop and admin are on different hosts
# VITE_WEB_ADMIN_ORIGIN=https://your-domain.com

# ─── AWS S3 (optional — MSA / documents) ─────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=pleros-documents-prod

# ─── NOTIFICATIONS ───────────────────────────────────────────────────────────
# Required in production: without SendGrid (or NOTIFICATION_WEBHOOK_URL) emails are not sent at all.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@your-domain.com
# Public app origin used in email links (required in production)
APP_URL=https://your-domain.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
EXPO_PUSH_ACCESS_TOKEN=

# ─── CELESTIAL AI ASSISTANT (optional — mock mode works without keys) ────────
# Provider: openrouter | groq | gemini | ollama | mock (default mock if no keys)
CELESTIAL_PROVIDER=
CELESTIAL_MODEL=
OPENROUTER_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
CELESTIAL_OLLAMA_URL=http://127.0.0.1:11434
CELESTIAL_OLLAMA_MODEL=llama3.2


# Database URLs for @pleros/web are set in docker-compose.production.yml per schema.
