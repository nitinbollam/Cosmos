# ─── POSTGRES ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-this-strong-password

# ─── REDIS ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://:change-this-redis-password@redis:6379
REDIS_PASSWORD=change-this-redis-password

# ─── MINIO (S3-compatible storage) ───────────────────────────────────────────
MINIO_ROOT_USER=cosmos-admin
MINIO_ROOT_PASSWORD=change-this-minio-password

# ─── AUTH ────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-64-char-random-hex
JWT_REFRESH_SECRET=replace-with-64-char-different-random-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ─── SERVICE-TO-SERVICE ───────────────────────────────────────────────────────
INTERNAL_SERVICE_SECRET=replace-with-shared-internal-secret-64-chars
GATEWAY_SERVICE_JWT_PUBLIC_KEY=
GATEWAY_SERVICE_JWT_PRIVATE_KEY=

# ─── STRIPE ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_PUBLISHABLE_KEY=pk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ─── AWS S3 (for documents, compliance reports) ───────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=replace_me
AWS_SECRET_ACCESS_KEY=replace_me
AWS_S3_BUCKET=cosmos-documents-prod

# ─── WEBHOOKS / WORKATO ───────────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=replace-with-32-char-random-hex
WEBHOOK_DEFAULT_TIMEOUT_MS=10000
WEBHOOK_MAX_RETRIES=3

# ─── NOTIFICATIONS ───────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.replace_me
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_me
EXPO_PUSH_ACCESS_TOKEN=replace_me

# ─── COMPLIANCE ───────────────────────────────────────────────────────────────
# Only required for TOBACCO_VAPE vertical
MSA_ENCRYPTION_KEY=replace-with-32-byte-encryption-key
MSA_RJR_EDI_ENDPOINT=https://edi.rjrt.com/multicat
MSA_PM_EDI_ENDPOINT=https://reporting.pmusa.com/multicat

# ─── AI SERVICES ─────────────────────────────────────────────────────────────
LLM_SERVICE_URL=http://cosmos-llm:8001
FORECASTING_SERVICE_URL=http://demand-forecasting:8002
OCR_SERVICE_URL=http://ocr-engine:8003
CASHFLOW_SERVICE_URL=http://cashflow-model:8004
ANOMALY_SERVICE_URL=http://anomaly-detection:8005
MODEL_STORE_S3_BUCKET=cosmos-models-prod

# ─── TELEMETRY (optional) ─────────────────────────────────────────────────────
COSMOS_OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
