NODE_ENV=development
LOG_LEVEL=info

# Each service uses its own logical database (suffixed with service name).
# In docker-compose Postgres they all share one cluster on port 5432.
DATABASE_URL=postgresql://cosmos:cosmos@localhost:5432/cosmos
REDIS_URL=redis://localhost:6379

# Machine-to-machine calls between services (order saga → inventory/payment/wms/compliance).
# Must match across services that accept InternalOrJwtAuthGuard.
INTERNAL_SERVICE_SECRET=replace-with-shared-internal-secret

# Gateway-issued RS256 service JWTs (V2). Each workload sets SERVICE_NAME to match JWT `aud`.
# Downstream services: PEM public key from gateway keypair. Gateway only: private key to mint tokens.
GATEWAY_SERVICE_JWT_PUBLIC_KEY=
GATEWAY_SERVICE_JWT_PRIVATE_KEY=
SERVICE_NAME=auth-service
APP_VERSION=0.0.0

# OpenTelemetry OTLP exporter (cosmos `@cosmos/tracing`). Off by default in dev/tests.
COSMOS_OTEL_ENABLED=false
JWT_SECRET=replace-with-256-bit-secret
JWT_REFRESH_SECRET=replace-with-256-bit-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Inter-service URLs (docker network names in compose, localhost for dev)
AUTH_SERVICE_URL=http://localhost:3001
TENANT_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
WMS_SERVICE_URL=http://localhost:3004
ORDER_SERVICE_URL=http://localhost:3005
PURCHASING_SERVICE_URL=http://localhost:3006
COMPLIANCE_SERVICE_URL=http://localhost:3007
STOREFRONT_SERVICE_URL=http://localhost:3008
POS_SERVICE_URL=http://localhost:3009
CRM_SERVICE_URL=http://localhost:3010
DISPATCH_SERVICE_URL=http://localhost:3011
PAYMENT_SERVICE_URL=http://localhost:3012
LEDGER_SERVICE_URL=http://localhost:3013
ANALYTICS_SERVICE_URL=http://localhost:3014
NOTIFICATION_SERVICE_URL=http://localhost:3015
GATEWAY_SERVICE_URL=http://localhost:3000

# AI Services
LLM_SERVICE_URL=http://localhost:8001
FORECASTING_SERVICE_URL=http://localhost:8002
OCR_SERVICE_URL=http://localhost:8003
CASHFLOW_SERVICE_URL=http://localhost:8004
ANOMALY_SERVICE_URL=http://localhost:8005

# Demand forecasting — optional durable model store (omit bucket to use local MODEL_STORE_DIR only).
# Uses same AWS credentials/region as other S3 workloads when set.
MODEL_STORE_S3_BUCKET=
MODEL_STORE_S3_PREFIX=demand-models
MODEL_STORE_DIR=/tmp/cosmos-models

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=cosmos-documents-dev
AWS_CLOUDFRONT_URL=https://assets.cosmos.local

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_RETURN_URL=http://localhost:3000/payments/return

# MSA
MSA_ENCRYPTION_KEY=replace-with-32-byte-encryption-key
MSA_RJR_EDI_ENDPOINT=https://edi.rjrt.com/multicat
MSA_PM_EDI_ENDPOINT=https://reporting.pmusa.com/multicat

# Notifications
SENDGRID_API_KEY=SG.replace_me
TWILIO_ACCOUNT_SID=AC_replace_me
TWILIO_AUTH_TOKEN=replace_me
EXPO_PUSH_ACCESS_TOKEN=replace_me

# Observability — set COSMOS_OTEL_ENABLED=true in workloads to activate @cosmos/tracing exporters.
OPENTELEMETRY_ENDPOINT=http://localhost:4317
# DLQ alerting: EventBusClient.subscribe(..., { dlq: dlqMonitorFromEnv('service-name') }) — logs exhausted jobs; PagerDuty if PAGERDUTY_ROUTING_KEY set
PAGERDUTY_ROUTING_KEY=

# AI/ML model paths (used by python services)
BASE_MODEL_PATH=mistralai/Mistral-7B-Instruct-v0.2
ADAPTER_PATH=/models/cosmos-compliance-adapter
