NODE_ENV=development
LOG_LEVEL=info

# Embedded SQLite — files under apps/web/.data (no Postgres, no Docker)
PLEROS_DATA_DIR=.data

# @pleros/web — prepare-dev-env writes apps/web/.env.local with file: URLs per domain
# AUTH_DATABASE_URL=file:.../apps/web/.data/pleros_auth.db

JWT_SECRET=replace-with-256-bit-secret
JWT_REFRESH_SECRET=replace-with-256-bit-refresh-secret
JWT_ACCESS_TTL=45m
JWT_REFRESH_TTL=7d

# Stripe (card checkout)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_connect_replace_me
# Optional: return/refresh URLs for Connect onboarding (defaults to COSMOS_CLIENT_ORIGIN)
STRIPE_CONNECT_RETURN_URL=http://localhost:4000
# Optional platform fee in basis points (e.g. 250 = 2.5%) — ASSUMPTION: unset = no application_fee_amount
# STRIPE_PLATFORM_APPLICATION_FEE_BPS=
STRIPE_RETURN_URL=http://localhost:4000/checkout

# AWS (optional — MSA file storage, documents)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=pleros-documents-dev

# Notifications — console log in dev; optional outbound webhook for integration testing
NOTIFICATION_WEBHOOK_URL=
PLEROS_OPS_EMAIL=admin@pleros.local
# Production email: set SENDGRID_API_KEY so verification / invite / reset emails are delivered.
# Without SendGrid in non-production, signup/resend may return verifyUrl for QA.
# In production, verifyUrl is never returned — configure SendGrid + APP_URL.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@pleros.local
# Public app origin used in verification / reset / invite links (required in production)
APP_URL=http://localhost:4000

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Browser push (Web Push). Generate a key pair once with: npx web-push generate-vapid-keys
# Changing the keys invalidates every existing browser subscription (users must turn push on again).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services: a mailto: address (or https URL)
VAPID_SUBJECT=mailto:ops@your-domain.com
# Mobile app push (Expo). Only needed if the Expo project enforces push security.
EXPO_PUSH_ACCESS_TOKEN=

# Celestial AI assistant (free-tier friendly — mock mode works without keys)
# Routing: Groq primary -> one hosted fallback (OpenRouter or Ollama Cloud; no local Ollama/Gemini). Offline mode without approval + keys.
# API keys alone never enable cloud calls; each approval below is a separate, explicit decision.
CELESTIAL_EXTERNAL_ROUTING_APPROVED=false
# Allow ERP records and conversation history in prompts sent to those providers.
CELESTIAL_EXTERNAL_DATA_APPROVED=false
GROQ_API_KEY=
CELESTIAL_PRIMARY_MODEL=openai/gpt-oss-120b
CELESTIAL_PRIMARY_TIMEOUT_MS=8000
# Fallback after Groq: openrouter (default) | ollama (Ollama Cloud, hosted) | none
CELESTIAL_FALLBACK=openrouter
OPENROUTER_API_KEY=
OLLAMA_API_KEY=
# Default per fallback: openrouter -> xingchen-agi/xing4.0-29b-a4b:free, ollama -> gpt-oss:120b
CELESTIAL_FALLBACK_MODEL=
CELESTIAL_FALLBACK_TIMEOUT_MS=25000
# Only allow ":free" fallback models (default true). Optional comma list of OpenRouter upstreams, e.g. Phala.
CELESTIAL_FALLBACK_FREE_ONLY=true
CELESTIAL_OPENROUTER_PROVIDERS=

# Observability (optional)
PLEROS_OTEL_ENABLED=false
OPENTELEMETRY_ENDPOINT=http://localhost:4317

# Production / scaled dev: Postgres (default local dev stays SQLite)
# PLEROS_DB_PROVIDER=postgres
# DATABASE_URL=postgresql://pleros:pleros@localhost:5432/postgres
# Setup: npm run db:setup:postgres → create DBs from infra/sql/init-databases.sql → npm run db:migrate
