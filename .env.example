NODE_ENV=development
LOG_LEVEL=info

# Embedded SQLite — files under apps/web/.data (no Postgres, no Docker)
COSMOS_DATA_DIR=.data

# @cosmos/web — prepare-dev-env writes apps/web/.env.local with file: URLs per domain
# AUTH_DATABASE_URL=file:.../apps/web/.data/cosmos_auth.db

JWT_SECRET=replace-with-256-bit-secret
JWT_REFRESH_SECRET=replace-with-256-bit-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Stripe (card checkout)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_RETURN_URL=http://localhost:4000/checkout

# AWS (optional — MSA file storage, documents)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=cosmos-documents-dev

# Notifications — console log in dev; optional outbound webhook for integration testing
NOTIFICATION_WEBHOOK_URL=
COSMOS_OPS_EMAIL=admin@cosmos.local
# Legacy provider keys (SendGrid/Twilio used when set)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@cosmos.local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
EXPO_PUSH_ACCESS_TOKEN=

# Observability (optional)
COSMOS_OTEL_ENABLED=false
OPENTELEMETRY_ENDPOINT=http://localhost:4317

# Later at scale: Postgres — set DATABASE_URL and COSMOS_DB_PROVIDER=postgres, then use infra:docker:up
