      "type": "file",
      "name": "auth-security.ts",
      "filePath": "apps/web/lib/server/auth-security.ts",
      "summary": "Provides password policy enforcement and per-process in-memory rate limiting for auth endpoints, with helpers for extracting client IP from forwarded headers.",
      "tags": ["security", "middleware", "validation", "utility"],
      "complexity": "moderate"
    },
    {
      "id": "function:apps/web/lib/server/auth-security.ts:assertPasswordPolicy",
      "type": "function",
      "name": "assertPasswordPolicy",
      "filePath": "apps/web/lib/server/auth-security.ts",
      "lineRange": [11, 21],
      "summary": "Validates a password string against the minimum length (10), maximum length (128), and alphanumeric complexity requirements, throwing ApiError 400 on failure.",
      "tags": ["validation", "security", "utility"],
      "complexity": "simple"
    },
    {
      "id": "function:apps/web/lib/server/auth-security.ts:rateLimit",
      "type": "function",
      "name": "rateLimit",
      "filePath": "apps/web/lib/server/auth-security.ts",
      "lineRange": [35, 48],
      "summary": "Enforces a fixed-window rate limit for a given key, throwing ApiError 429 with a retry-after hint when the limit is exceeded; cleans up expired windows on overflow.",
      "tags": ["security", "rate-limiting", "middleware"],
      "complexity": "simple"
    },
    {
      "id": "file:apps/web/lib/server/auth.ts",
      "type": "file",
      "name": "auth.ts",
      "filePath": "apps/web/lib/server/auth.ts",
      "summary": "Implements the complete authentication lifecycle for the ERP platform including login, registration, JWT token signing, refresh, logout, email verification, password reset, and invite acceptance using bcrypt and JOSE.",
      "tags": ["authentication", "service", "security", "api-handler"],
      "complexity": "complex",
      "languageNotes": "Uses JOSE for HS256 JWT signing and bcrypt for password and refresh-token hashing. Dynamic imports of notification-provider avoid circular dependencies at module load time."
    },
    {
      "id": "function:apps/web/lib/server/auth.ts:signPair",
      "type": "function",
      "name": "signPair",
      "filePath": "apps/web/lib/server/auth.ts",
      "lineRange": [16, 46],
      "summary": "Signs and returns an access+refresh JWT pair for a user, storing the bcrypt-hashed refresh token in the database for rotation validation.",
      "tags": ["authentication", "jwt", "utility"],
      "complexity": "moderate"
    },
    {
      "id": "function:apps/web/lib/server/auth.ts:loginUser",
      "type": "function",
      "name": "loginUser",
      "filePath": "apps/web/lib/server/auth.ts",
      "lineRange": [48, 65],
      "summary": "Authenticates a user by email and password, enforces email-verification gate for new signups, updates lastLoginAt, and returns a signed token pair.",
      "tags": ["authentication", "service"],
      "complexity": "simple"
    },
    {
      "id": "function:apps/web/lib/server/auth.ts:registerUser",
      "type": "function",
      "name": "registerUser",
      "filePath": "apps/web/lib/server/auth.ts",
      "lineRange": [67, 105],
      "summary": "Creates a new user for a given tenant after validating the tenant exists and the email is unique, enforcing password policy and optionally issuing tokens or triggering email verification.",
      "tags": ["authentication", "service", "validation"],
      "complexity": "moderate"
    },
    {
      "id": "function:apps/web/lib/server/auth.ts:acceptInvite",
      "type": "function",
      "name": "acceptInvite",
      "filePath": "apps/web/lib/server/auth.ts",
      "lineRange": [127, 161],
      "summary": "Validates an admin-issued invite token, registers the invited user with the associated role and tenant, and marks the invite as accepted.",
      "tags": ["authentication", "service", "security"],
      "complexity": "moderate"
    },
    {
      "id": "function:apps/web/lib/server/auth.ts:sendEmailVerification",
      "type": "function",
      "name": "sendEmailVerification",
      "filePath": "apps/web/lib/server/auth.ts",
      "lineRange": [163, 189],
      "summary": "Generates a 32-byte random email verification token, stores its SHA-256 hash with a 24-hour expiry, and delivers the verification email via the notification provider.",
      "tags": ["authentication", "service", "notification"],
      "complexity": "moderate"
    },
    {
      "id": "function:apps/web/lib/server/auth.ts:verifyEmail",
      "type": "function",
      "name": "verifyEmail",
      "filePath": "apps/web/lib/server/auth.ts",
      "lineRange": [191, 205],
      "summary": "Validates an email verification token against its stored SHA-256 hash and expiry, then marks the user's email as verified.",
      "tags": ["authentication", "service", "validation"],
      "complexity": "simple"
    },
    {
      "id": "function:apps/web/lib/server/auth.ts:requestPasswordReset",
      "type": "function",
      "name": "requestPasswordReset",
      "filePath": "apps/web/lib/server/auth.ts",
      "lineRange": [216, 243],
      "summary": "Generates a 30-minute password reset token stored as a SHA-256 hash and sends the reset link by email without revealing whether the address exists.",
      "tags": ["authentication", "service", "security"],
      "complexity": "moderate"
    },
    {
      "id": "function:apps/web/lib/server/auth.ts:resetPassword",
      "type": "function",
      "name": "resetPassword",
      "filePath": "apps/web/lib/server/auth.ts",
      "lineRange": [245, 264],
      "summary": "Validates the password reset token, enforces the password policy on the new password, re-hashes it, and invalidates all existing sessions by clearing the refresh token hash.",
      "tags": ["authentication", "service", "security"],
      "complexity": "moderate"
    },
    {
      "id": "function:apps/web/lib/server/auth.ts:changePassword",
      "type": "function",
      "name": "changePassword",
      "filePath": "apps/web/lib/server/auth.ts",
      "lineRange": [266, 277],
      "summary": "Allows an authenticated user to change their password by verifying the current password, enforcing the new password policy, and invalidating existing sessions.",
      "tags": ["authentication", "service", "security"],
      "complexity": "simple"
    },
