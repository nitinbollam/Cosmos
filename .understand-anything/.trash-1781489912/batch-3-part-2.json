      "name": "native-router.ts",
      "filePath": "apps/web/lib/server/native-router.ts",
      "summary": "The central API request dispatcher that routes all native HTTP requests to the appropriate domain handler modules, covering every ERP domain from inventory and orders to payments, WMS, dispatch, EDI, accounting, and AI.",
